# =============================================================================
# .env — Variabel level Docker Compose
# Salin file ini ke .env dan isi semua nilai sebelum menjalankan compose.
#
# File ini dibaca oleh docker-compose.yml untuk interpolasi ${VAR}.
# Nilai ini juga di-pass ke container backend via environment: block.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=postgres
# Gunakan password kuat di production. Minimal 16 karakter acak.
DB_PASSWORD=ganti_password_postgres_ini
DB_DATABASE=survei_online

# ── Redis ─────────────────────────────────────────────────────────────────────
# Wajib diisi. Harus sama dengan yang dikonfigurasi di backend/.env
REDIS_PASSWORD=ganti_password_redis_ini

# ── MinIO (S3-compatible storage) ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
# Minimal 8 karakter
MINIO_ROOT_PASSWORD=ganti_password_minio_ini

# ── CORS ──────────────────────────────────────────────────────────────────────
# Domain frontend yang diizinkan mengakses API.
# Pisahkan dengan koma jika lebih dari satu.
# Contoh production: https://survei.contoh.id
ALLOWED_ORIGINS=http://localhost
