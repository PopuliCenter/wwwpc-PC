<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Parent DayNight wajib: WebView menentukan prefers-color-scheme dari isLightTheme tema
         ini, jadi parent Light membuat "Ikuti sistem" selalu terang. Warna untuk mode gelap HP
         ada di values-night; pilihan yang berbeda dari sistem disetel PopuliThemePlugin.
         Warna bar navigasi hanya di API 26 (values-v26, ikon dari PopuliThemePlugin) dan
         API 27+ (values-v27, ikon dari tema). Di API 24-25 ikon bar navigasi tidak bisa
         dijadikan gelap sama sekali. Perubahan di sini ikut disalin ke kedua berkas itu. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/populi_chrome</item>
        <item name="android:windowLightStatusBar">@bool/populi_light_bars</item>
        <!-- Android 15+ mengabaikan statusBarColor dan memakai warna ini di balik bar. -->
        <item name="android:windowBackground">@color/populi_chrome</item>
    </style>


    <!-- android:background untuk Android 11 ke bawah; atribut windowSplashScreen* untuk
         Android 12+. Ikon memakai ikon adaptif, bukan ic_launcher_foreground, karena
         logo di PNG itu melewati lingkaran masker splash Android 12+ dan akan terpotong. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/populi_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
