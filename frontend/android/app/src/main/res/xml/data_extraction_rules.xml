<?xml version="1.0" encoding="utf-8"?>
<!--
  Audit T-41: pada Android 12+ (targetSdk 31+) allowBackup="false" TIDAK lagi
  mencegah transfer perangkat-ke-perangkat. Aturan ini mengecualikan SEMUA
  domain dari backup cloud maupun device transfer, sehingga token sesi
  (localStorage WebView), antrean offline (IndexedDB) dan berkas lokal tidak
  pernah ikut tersalin ke perangkat/akun lain.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
