<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Salinan penuh AppTheme.NoActionBar dari values/styles.xml, ditambah warna dan ikon
         bar navigasi. android:windowLightNavigationBar baru ada di API 27. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/populi_chrome</item>
        <item name="android:windowLightStatusBar">@bool/populi_light_bars</item>
        <!-- Android 15+ mengabaikan statusBarColor dan memakai warna ini di balik bar. -->
        <item name="android:windowBackground">@color/populi_chrome</item>
        <item name="android:navigationBarColor">@color/populi_chrome</item>
        <item name="android:windowLightNavigationBar">@bool/populi_light_bars</item>
    </style>
</resources>
