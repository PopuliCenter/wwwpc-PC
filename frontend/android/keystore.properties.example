# Template kredensial penandatanganan rilis Play Store.
# SALIN file ini menjadi `keystore.properties` (di folder yang sama, yaitu
# frontend/android/) lalu isi nilainya. File asli DI-GITIGNORE — jangan commit,
# dan SIMPAN keystore (.jks) + password di tempat aman. Bila keystore hilang,
# Anda tidak bisa lagi memperbarui app di Play Store.
#
# Buat keystore (sekali saja), dari folder frontend/android/:
#   keytool -genkey -v -keystore populi-survei-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias populi-survei
#
# Ambil SHA-1 & SHA-256 (daftarkan ke Firebase + OAuth client Android):
#   keytool -list -v -keystore populi-survei-release.jks -alias populi-survei
#
# Catatan: dengan Play App Signing, daftarkan JUGA SHA-1 "App signing key" dari
# Play Console (Setup -> App integrity) ke Firebase, bukan hanya upload key.

storeFile=populi-survei-release.jks
storePassword=GANTI_password_keystore
keyAlias=populi-survei
keyPassword=GANTI_password_key
