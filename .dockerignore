# Keamanan (audit T-01): jangan bawa skrip seed, test, atau berkas ekspor
# (bisa berisi data pribadi responden) ke konteks build image.
backend/scripts/
backend/test/
backend/exports/

# Rahasia lokal & proyek native (audit T-42): keystore rilis, kredensial
# signing, env build native. Image akhir sudah bersih; ini mencegahnya masuk
# konteks/cache build lokal. Build web tidak membutuhkan frontend/android/.
frontend/android/
**/*.jks
**/*.keystore
**/keystore.properties
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.dump
**/*.sql.gz
