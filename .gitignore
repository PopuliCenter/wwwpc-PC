# Dependencies
node_modules/

# Build outputs
dist/
build/

# Environment files — SEMUA varian .env.* (development, staging, test, …)
# kecuali contoh yang memang dibagikan (audit T-28).
.env
.env.local
.env.*.local
.env.*
!.env.example
# .env.production berisi konfigurasi BUILD NATIVE (Capacitor) lokal: URL API
# absolut, VITE_GOOGLE_CLIENT_ID, VITE_ENABLE_PUSH. JANGAN di-commit — VPS punya
# .env.production sendiri untuk build web; commit akan menimpanya saat git pull.
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/

# Logs
*.log
logs/

# Temp
tmp/
temp/

# Pricelist IAK / data harga (berisi margin — jangan masuk git atau folder web publik)
docs/iak/*.xlsx
frontend/public/*.xlsx

# Capacitor — proyek native (butuh Android Studio/Xcode untuk build)
# frontend/android/ SENGAJA DI-COMMIT agar mudah ditemukan & kustomisasi
# (ikon, izin, signing config) tersimpan. Capacitor membuat android/.gitignore
# sendiri yang mengabaikan artefak build (build/, .gradle/, local.properties).
# iOS menyusul — diabaikan dulu sampai `cap add ios` dijalankan
frontend/ios/
# Jaga-jaga: jangan pernah commit artefak/rahasia native
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/release/
*.keystore
*.jks

# ── Rahasia & data yang tidak boleh masuk repo PUBLIK (audit T-28) ──────────
# Dump database (pg_dump di clone VPS: arahkan ke /var/backups/survei).
*.sql
*.sql.gz
*.dump
backups/
# Pengecualian: skrip init Postgres yang memang bagian dari repo.
!docker/postgres/*.sql
# Kunci & sertifikat
*.pem
*.key
*.p12
*service-account*.json
# Artefak rilis Android
*.apk
*.aab
frontend/android/keystore.properties
