# Application
NODE_ENV=development
PORT=3000

# Number of trusted proxy hops in front of the app (Cloudflare -> Nginx -> app).
# Nginx is the single hop that talks to the app, so 1 is correct for the
# default docker-compose setup. Increase only if you add more reverse proxies.
TRUST_PROXY_HOPS=1

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Use a strong, unique password in production. Never ship the default.
DB_PASSWORD=postgres
DB_DATABASE=survei_online
DB_SYNCHRONIZE=false
DB_LOGGING=true
# Enable TLS to the database in production.
DB_SSL=false

# Connection Pooling
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REQUIRED in production. Must match the password Redis is started with
# (redis-server --requirepass ...). Leave empty only for local dev.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=survei:

# Redis Cache TTL (seconds)
REDIS_CACHE_TTL=300

# Bull Queue (uses Redis)
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=
BULL_REDIS_DB=1

# JWT Authentication
# Generate a strong secret, e.g. `openssl rand -hex 32`. The placeholder below
# MUST be replaced before deploying — the app should refuse to start otherwise.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_TTL=604800

# Brute-force protection (login)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Anti-fraud: minimum seconds a respondent must spend before a submission is
# accepted (rejects bot-speed completions).
MIN_COMPLETION_SECONDS=5

# S3/MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=survey-exports
S3_REGION=us-east-1
S3_USE_SSL=false
# Pre-signed URL expiry in seconds (default: 900 = 15 minutes)
S3_PRESIGNED_URL_EXPIRES_IN=900

# CORS — comma-separated list of allowed frontend origins.
# In production set this to your real domain(s), e.g. https://survei.example.com
ALLOWED_ORIGINS=http://localhost:5173
