# =============================================================================
# backend/.env — Variabel environment backend NestJS
# Salin ke backend/.env dan sesuaikan sebelum menjalankan.
#
# PENTING saat deploy Docker:
#   Nilai DB_HOST, REDIS_HOST, S3_ENDPOINT di-override oleh docker-compose.yml
#   agar menggunakan nama service Docker (postgres, redis, minio).
#   Nilai di file ini digunakan untuk pengembangan lokal (localhost).
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Jumlah hop proxy tepercaya di depan app (Cloudflare → Nginx → app = 1).
TRUST_PROXY_HOPS=1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=ganti_password_postgres_ini
DB_DATABASE=survei_online

# true  → TypeORM sinkronisasi skema otomatis (dev only, JANGAN di production)
# false → gunakan migration (wajib di production)
DB_SYNCHRONIZE=true
DB_LOGGING=true
DB_SSL=false

# Connection pooling
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Isi saat Redis dikonfigurasi dengan requirepass (wajib di production)
REDIS_PASSWORD=ganti_password_redis_ini
REDIS_DB=0
REDIS_KEY_PREFIX=survei:
REDIS_CACHE_TTL=300

# ── Bull Queue (menggunakan Redis) ────────────────────────────────────────────
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=ganti_password_redis_ini
BULL_REDIS_DB=1

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=ganti_jwt_secret_minimal_32_karakter_acak
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_TTL=604800

# ── Brute-force protection (login) ────────────────────────────────────────────
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ── Anti-fraud ────────────────────────────────────────────────────────────────
# Minimum detik yang harus dihabiskan responden sebelum submit diterima.
MIN_COMPLETION_SECONDS=5

# ── Upload file respondent ────────────────────────────────────────────────────
# Batas ukuran dalam byte (default 5 MB = 5242880).
# Harus konsisten dengan client_max_body_size di nginx.
UPLOAD_MAX_BYTES=5242880

# ── S3 / MinIO Storage ────────────────────────────────────────────────────────
# Di Docker, S3_ENDPOINT di-override ke http://minio:9000 oleh compose.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=ganti_password_minio_ini
S3_BUCKET_EXPORTS=survey-exports
S3_BUCKET_UPLOADS=survey-uploads
S3_REGION=us-east-1
S3_USE_SSL=false
# Masa berlaku presigned URL dalam detik (default 15 menit)
S3_PRESIGNED_URL_EXPIRES_IN=900

# ── CORS ──────────────────────────────────────────────────────────────────────
# Pisahkan dengan koma jika lebih dari satu origin.
# Production: https://survei.contoh.id
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ── Email (OTP pendaftaran & reset password) ──────────────────────────────────
# Pilih provider: 'smtp' atau 'resend'. Kosongkan untuk auto (resend bila ada
# RESEND_API_KEY, lalu smtp bila ada SMTP_HOST; jika keduanya kosong → email
# TIDAK dikirim, hanya di-log → pendaftaran mandiri terblokir).
EMAIL_PROVIDER=smtp
# Pengirim (harus mailbox/domain yang sah).
MAIL_FROM=Populi Center <info@populicenter.org>
# URL aplikasi (untuk logo di email).
APP_URL=https://survei.risetcenter.com

# Opsi A — SMTP (mis. mailbox Hostinger info@populicenter.org; tanpa verifikasi domain)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@populicenter.org
SMTP_PASS=ganti_password_mailbox_ini

# Opsi B — Resend (perlu verifikasi domain populicenter.org di Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Hostname cert cPanel sering beda (mis. webmail.<domain>). Set false bila
# kirim gagal "certificate"/hostname mismatch (tetap terenkripsi).
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Alternatif: cocokkan ke nama cert yang benar tanpa mematikan verifikasi.
# SMTP_TLS_SERVERNAME=webmail.populicenter.org

# ─── Reward fulfillment (pengisian reward) ──────────────────────────────────
# Provider pemenuhan reward: 'manual' (default — admin proses & finalisasi via
# endpoint admin) atau 'iak' (otomatis via gateway PPOB IAK / iak.id).
REWARD_PROVIDER=manual

# Konfigurasi IAK (hanya dipakai bila REWARD_PROVIDER=iak).
# Sandbox: https://prepaid.iak.dev  |  Produksi: https://prepaid.iak.id
# IAK_BASE_URL=https://prepaid.iak.dev
# IAK_USERNAME=username_developer_iak
# IAK_API_KEY=api_key_prepaid_iak
# Sandbox: paksa satu product_code utk SEMUA top-up agar mudah diuji.
# IAK_TEST_PRODUCT_CODE=
# Produksi: peta → product_code IAK (JSON satu baris). Kunci:
#  - pulsa/paket_data (operator-spesifik): "<operator>:<rewardId>"
#    operator otomatis dideteksi dari prefix HP: telkomsel|indosat|xl|axis|tri|smartfren
#  - voucher/e_wallet: "<rewardId>"
# IAK_PRODUCT_MAP={"telkomsel:pulsa-10000":"tsel10","indosat:pulsa-10000":"iso10","data-1gb":"xld1"}
#
# Verifikasi keaslian callback: md5(username+api_key+ref_id). Default true.
# IAK_VERIFY_CALLBACK_SIGN=true
#
# URL callback yang didaftarkan di menu Callback IAK:
#   https://survei.risetcenter.com/api/rewards/callback/iak
